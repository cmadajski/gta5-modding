set(CMAKE_SYSTEM_NAME Windows)
set(CMAKE_SYSTEM_PROCESSOR AMD64)

set(LLVM_MINGW_ROOT "$ENV{LLVM_MINGW_ROOT}" CACHE PATH "Extracted LLVM-MinGW toolchain directory")
list(APPEND CMAKE_TRY_COMPILE_PLATFORM_VARIABLES LLVM_MINGW_ROOT)

find_program(CMAKE_C_COMPILER x86_64-w64-mingw32-clang
    HINTS "${LLVM_MINGW_ROOT}/bin" NO_CMAKE_FIND_ROOT_PATH REQUIRED
)
find_program(CMAKE_CXX_COMPILER x86_64-w64-mingw32-clang++
    HINTS "${LLVM_MINGW_ROOT}/bin" NO_CMAKE_FIND_ROOT_PATH REQUIRED
)
find_program(CMAKE_RC_COMPILER x86_64-w64-mingw32-windres
    HINTS "${LLVM_MINGW_ROOT}/bin" NO_CMAKE_FIND_ROOT_PATH REQUIRED
)

get_filename_component(llvm_mingw_bin "${CMAKE_C_COMPILER}" DIRECTORY)
set(CMAKE_FIND_ROOT_PATH "${llvm_mingw_bin}/../x86_64-w64-mingw32")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
